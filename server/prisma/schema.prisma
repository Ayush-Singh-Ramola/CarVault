// ============================================================================
// CarVault — Prisma Schema
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  PLUG_IN_HYBRID
  CNG
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
  CVT
}

enum BodyType {
  SEDAN
  SUV
  HATCHBACK
  COUPE
  CONVERTIBLE
  WAGON
  PICKUP_TRUCK
  MINIVAN
  CROSSOVER
}

enum DriveType {
  FWD
  RWD
  AWD
  FOUR_WD
}

enum CarStatus {
  AVAILABLE
  SOLD
  PENDING
  DRAFT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  avatarUrl String?
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites   Favorite[]
  reviews     Review[]
  carsCreated Car[]      @relation("CarCreatedBy")

  @@index([email])
  @@map("users")
}

model Brand {
  id      String  @id @default(cuid())
  name    String  @unique
  logoUrl String?
  country String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars Car[]

  @@index([name])
  @@map("brands")
}

model Car {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  model       String
  year        Int
  price       Decimal  @db.Decimal(12, 2)
  mileage     Int
  color       String?
  description String?  @db.Text

  fuelType     FuelType
  transmission TransmissionType
  bodyType     BodyType
  status       CarStatus @default(AVAILABLE)
  isFeatured   Boolean   @default(false)

  avgRating   Float @default(0)
  reviewCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  brandId String

  createdBy   User?   @relation("CarCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  images         Image[]
  specifications Specifications?
  favorites      Favorite[]
  reviews        Review[]

  @@index([brandId])
  @@index([price])
  @@index([year])
  @@index([fuelType])
  @@index([transmission])
  @@index([bodyType])
  @@index([status])
  @@index([createdAt])
  @@map("cars")
}

model Specifications {
  id String @id @default(cuid())

  engine            String?
  horsepower        Int?
  torqueNm          Int?
  drivetrain        DriveType?
  seatingCapacity   Int?
  doors             Int?
  safetyRating      Float?
  acceleration0to60 Float?
  topSpeedKmh       Int?
  fuelTankCapacityL Float?
  fuelEconomyKmpl   Float?
  weightKg          Int?

  features String[]

  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("specifications")
}

model Image {
  id        String  @id @default(cuid())
  url       String
  publicId  String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId String

  createdAt DateTime @default(now())

  @@index([carId])
  @@map("images")
}

model Favorite {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId String

  createdAt DateTime @default(now())

  @@unique([userId, carId])
  @@index([userId])
  @@index([carId])
  @@map("favorites")
}

model Review {
  id      String @id @default(cuid())
  rating  Int
  comment String? @db.Text

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, carId])
  @@index([carId])
  @@map("reviews")
}