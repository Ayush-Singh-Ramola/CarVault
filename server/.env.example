# Environment
NODE_ENV=development
PORT=5000

# PostgreSQL connection string (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/carvault?schema=public"

# JWT
JWT_SECRET=replace-with-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary (optional — leave USE_CLOUDINARY=false to store images locally in /uploads)
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Security
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# PRODUCTION NOTES
# ---------------------------------------------------------------------------
# 1. NODE_ENV=production flips cookie sameSite to 'none' + secure=true
#    (see src/controllers/authController.js) — required for the frontend
#    and backend to sit on different domains (e.g. Vercel + Render).
# 2. JWT_SECRET must be a long, random value in production — generate one:
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 3. CLIENT_URL must exactly match your deployed frontend origin (including
#    https://) or CORS will reject every request.
# 4. USE_CLOUDINARY must be 'true' on any host with an ephemeral filesystem
#    (Render, Railway, Vercel serverless) — local /uploads storage only
#    works on a host with a persistent disk (e.g. a VPS via Docker Compose).